{
  "name": "on-cli",
  "version": "0.2.0",
  "description": "CLI for the ON (Orka náttúrunnar) EV-charging app — sessions, vehicles, chargers, invoices, and RFID keys from your terminal. AI-agent friendly. Built with Bun.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "on": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile on",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check src/",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test": "bun test",
    "verify:mcp": "bun scripts/verify-mcp.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
